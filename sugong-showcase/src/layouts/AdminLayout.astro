---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="same-origin" />
    <title>{title}</title>
  </head>
  <body class="admin-shell min-h-screen bg-background-main text-text-primary">
    <a class="skip-link" href="#admin-content">Bỏ qua đến nội dung quản trị</a>
    <div id="admin-content">
      <slot />
    </div>
  </body>
</html>
