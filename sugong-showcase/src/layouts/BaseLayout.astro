---
import "../styles/global.css";
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import { MobileNavigation } from "../features/mobile-navigation/MobileNavigation";
import { createSeo, type SeoInput } from "../lib/seo";
import { brand, navigationItems, socialLinks } from "../lib/site-data";
import { withBase, withoutBase } from "../lib/url";

interface Props extends SeoInput {}

const seo = createSeo(Astro.props);
const currentPath = withoutBase(Astro.url.pathname);
const cloudinaryCloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={seo.description} />
    <meta name="theme-color" content="#f8f5fc" />
    <title>{seo.title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>document.documentElement.classList.add("motion-ready");</script>
    {cloudinaryCloudName && <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background-main text-text-primary antialiased">
    <a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>
    <header data-site-header class="sticky top-0 z-50 bg-background-main/90 shadow-[0_1px_0_rgb(228_218_239/45%)] backdrop-blur">
      <Container class="flex h-header max-w-wide items-center justify-between gap-6">
        <a class="font-heading text-2xl font-bold tracking-normal text-primary-dark" href={withBase("/")}>SUGONG</a>
        <nav class="hidden items-center gap-7 text-sm font-medium text-text-secondary lg:flex" aria-label="Điều hướng chính">
          {navigationItems.map((item) => (
            <a
              class:list={[
                "relative py-2 transition-colors after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-right after:scale-x-0 after:bg-primary-dark after:transition-transform hover:text-primary-dark hover:after:origin-left hover:after:scale-x-100",
                !item.href.includes("#") && (currentPath === item.href || currentPath.startsWith(`${item.href}/`))
                  ? "text-primary-dark after:scale-x-100"
                  : "text-text-secondary",
              ]}
              href={withBase(item.href)}
              aria-current={!item.href.includes("#") && (currentPath === item.href || currentPath.startsWith(`${item.href}/`)) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-3">
          <div class="hidden min-[370px]:block">
            <Button href={brand.channels.zalo} size="sm">Nhắn Zalo</Button>
          </div>
          <MobileNavigation items={navigationItems} currentPath={currentPath} client:idle />
        </div>
      </Container>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="bg-background-card py-10 shadow-[0_-1px_0_rgb(228_218_239/38%)]">
      <Container class="grid max-w-wide gap-8 text-sm text-text-secondary sm:grid-cols-2 lg:grid-cols-[1.1fr_1fr_1fr] lg:items-start">
        <div class="space-y-3">
          <p class="font-heading text-2xl text-primary-dark">{brand.name}</p>
          <p class="max-w-sm leading-6">{brand.description}</p>
        </div>
        <nav class="grid gap-3" aria-label="Điều hướng chân trang">
          {navigationItems.map((item) => <a class="hover:text-primary-dark" href={withBase(item.href)}>{item.label}</a>)}
        </nav>
        <div class="grid gap-3">
          {socialLinks.map((item) => (
            <a class="hover:text-primary-dark" href={withBase(item.href)}>
              {item.name}
            </a>
          ))}
        </div>
      </Container>
    </footer>
    <script>
      const header = document.querySelector("[data-site-header]");
      const updateHeader = () => header?.toggleAttribute("data-scrolled", window.scrollY > 12);
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const sections = document.querySelectorAll("main > section:not(:first-child)");
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        sections.forEach((section) => observer.observe(section));
      }
    </script>
  </body>
</html>
