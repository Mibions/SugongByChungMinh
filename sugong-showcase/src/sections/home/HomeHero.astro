---
import { MessageCircle, ShoppingBag, Sparkles } from "lucide-react";
import Button from "../../components/ui/Button.astro";
import Container from "../../components/ui/Container.astro";
import { brand } from "../../content/site";
import { withBase } from "../../lib/url";

const tiktokVideoIds = brand.heroTikTokVideoIds;
const tiktokEmbedUrl = tiktokVideoIds.length > 0
  ? `https://www.tiktok.com/player/v1/${tiktokVideoIds[0]}?autoplay=1&loop=1&muted=1&controls=1&description=0&music_info=0`
  : "";
---

<section class="relative isolate overflow-hidden bg-[linear-gradient(135deg,#fffaf6_0%,#f7f0ff_46%,#fff6fb_100%)] py-10 shadow-[inset_0_-1px_0_rgb(228_218_239/35%)] lg:py-14">
  <div class="pointer-events-none absolute inset-y-0 left-1/2 z-[-1] hidden w-[58%] -translate-x-1/2 bg-background-main/75 blur-2xl lg:block"></div>
  <img
    class="pointer-events-none absolute bottom-0 left-0 z-[-1] hidden h-full w-72 object-cover object-left-bottom opacity-45 md:block"
    style="-webkit-mask-image: linear-gradient(to right, black 0%, black 42%, transparent 100%); mask-image: linear-gradient(to right, black 0%, black 42%, transparent 100%);"
    src={withBase("/assets/brand/header-left.webp")}
    alt=""
    width="1024"
    height="1536"
    loading="eager"
    fetchpriority="high"
  />
  <img
    class="pointer-events-none absolute bottom-0 right-0 z-[-1] hidden h-full w-80 object-cover object-right-bottom opacity-35 lg:block"
    style="-webkit-mask-image: linear-gradient(to left, black 0%, black 46%, transparent 100%); mask-image: linear-gradient(to left, black 0%, black 46%, transparent 100%);"
    src={withBase("/assets/brand/header-right.webp")}
    alt=""
    width="1024"
    height="1536"
    loading="lazy"
    decoding="async"
  />

  <Container class="max-w-wide">
    <div class="grid gap-9 lg:min-h-[600px] lg:grid-cols-[0.94fr_1fr] lg:items-center lg:gap-10">
      <div class="max-w-xl space-y-7">
        <p class="inline-flex items-center gap-2 rounded-full border border-primary-soft/30 bg-background-card/80 px-4 py-2 text-sm font-semibold uppercase text-primary-dark shadow-soft">
          <Sparkles size={16} aria-hidden="true" />
          Handmade with love
        </p>
        <h1 class="text-balance font-heading text-5xl leading-[1.06] tracking-[-0.025em] text-primary-dark sm:text-6xl lg:text-7xl">
          Quà handmade theo cách riêng của bạn
        </h1>
        <p class="text-pretty max-w-md text-lg leading-8 text-text-secondary">{brand.description}</p>
        <div class="flex flex-wrap gap-4">
          <Button href="/products">
            <span class="inline-flex items-center gap-2">
              <ShoppingBag size={18} aria-hidden="true" />
              Khám phá sản phẩm
            </span>
          </Button>
          <Button href={brand.channels.zalo} variant="secondary">
            <span class="inline-flex items-center gap-2">
              <MessageCircle size={18} aria-hidden="true" />
              Liên hệ qua Zalo
            </span>
          </Button>
        </div>
      </div>

      <div class="flex justify-center lg:justify-center">
        <div data-tiktok-frame class="relative aspect-[4/5] w-full max-w-[430px] overflow-hidden rounded-[22px] bg-text-primary shadow-feather ring-1 ring-background-card/70">
          <img
            data-tiktok-poster
            class="absolute inset-0 z-20 h-full w-full object-cover"
            style="object-position: 18% center;"
            src={withBase("/assets/brand/footer-bag.webp")}
            alt=""
            width="1600"
            height="533"
            loading="eager"
            fetchpriority="high"
          />
          {
            tiktokEmbedUrl ? (
              <iframe
                data-tiktok-iframe
                class="relative z-10 h-full w-full bg-transparent opacity-0"
                src={tiktokEmbedUrl}
                title="Video TikTok SUGONG tự động phát"
                loading="eager"
                allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                allowfullscreen
              />
            ) : (
              <a
                class="absolute inset-0 z-10 grid place-items-center bg-text-primary/55 p-6 text-center font-medium text-background-card"
                href={brand.tiktokProfileUrl}
              >
                Xem video trên TikTok SUGONG
              </a>
            )
          }
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  const tiktokFrame = document.querySelector("[data-tiktok-frame]");
  const tiktokIframe = tiktokFrame?.querySelector("[data-tiktok-iframe]");

  tiktokIframe?.addEventListener("load", () => {
    tiktokFrame?.classList.add("is-loaded");
  });
</script>

<style>
  [data-tiktok-poster],
  [data-tiktok-iframe] {
    transition: opacity 500ms var(--ease-editorial);
  }

  [data-tiktok-frame].is-loaded [data-tiktok-poster] {
    pointer-events: none;
    opacity: 0;
  }

  [data-tiktok-frame].is-loaded [data-tiktok-iframe] {
    opacity: 1;
  }
</style>
