---
import Container from "../../components/ui/Container.astro";
import { Gift, HandHeart, MessageCircle, WandSparkles } from "lucide-react";
import { trustItems } from "../../content/site";

const icons = {
  handmade: HandHeart,
  custom: WandSparkles,
  message: MessageCircle,
  gift: Gift,
};
---

<section id="why-sugong" class="bg-background-main py-section-mobile">
  <Container class="grid max-w-wide gap-9 lg:grid-cols-[0.72fr_1fr] lg:gap-16">
    <div class="max-w-xl lg:pt-4">
      <p class="text-sm font-semibold tracking-[0.08em] text-primary-dark">Vì sao chọn SUGONG?</p>
      <h2 class="text-balance mt-3 font-heading text-3xl leading-tight text-primary-dark sm:text-4xl">Những món quà nhỏ, được chăm chút kỹ</h2>
      <p class="text-pretty mt-4 text-sm leading-7 text-text-secondary">
        Từng lựa chọn đều hướng về cảm giác riêng tư, nhẹ nhàng và vừa vặn với người nhận.
      </p>
    </div>
    <div class="grid border-t border-border sm:grid-cols-2">
      {trustItems.map((item, index) => {
        const Icon = icons[item.icon];

        return (
          <article class="grid grid-cols-[auto_1fr] gap-4 border-b border-border py-6 sm:px-5 sm:first:pl-0 sm:nth-[2]:pr-0 sm:nth-[3]:pl-0 sm:last:pr-0">
            <span class="flex h-10 w-10 items-center justify-center rounded-[14px] bg-background-section text-primary-dark">
              <Icon size={19} aria-hidden="true" />
            </span>
            <div>
              <p class="mb-2 text-xs font-semibold tracking-[0.12em] text-primary">0{index + 1}</p>
              <h3 class="font-heading text-xl text-primary-dark">{item.title}</h3>
              <p class="text-pretty mt-2 text-sm leading-6 text-text-secondary">{item.description}</p>
            </div>
          </article>
        );
      })}
    </div>
  </Container>
</section>
